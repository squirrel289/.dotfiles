# Ignore MacOS files
.DS_Store
plugged/
.vim/undo/*
.netrwhist

# Ignore all *.swp in case vim didn't clean up
*.swp

# Ignore all *.pems so we don't accidentally expose secrets
*.pem

# only include whitelisted configs
.config/*
!.config/configstore
!.config/ghostty
!.config/gtk-2.0
!.config/inkscape
!.config/nvim
!.config/yamllint
!.config/zellij
.config/zellij/plugins/*

# Ignore operational artifacts
.pi/
