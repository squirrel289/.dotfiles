# POSIX-parsed capability dispatcher for Bash and Zsh only.
_dotfiles_register_aws() {
    _dotfiles_target=$1
    _dotfiles_aws_completer=$(command -v aws_completer 2>/dev/null) || return 0
    [ -n "$_dotfiles_aws_completer" ] && [ -f "$_dotfiles_aws_completer" ] && [ -x "$_dotfiles_aws_completer" ] || return 0

    case $_dotfiles_target in
        bash)
            complete -C "$_dotfiles_aws_completer" aws
            ;;
        zsh)
            if ! command -v compdef >/dev/null 2>&1; then
                autoload -Uz compinit
                compinit -i
            fi
            autoload -Uz bashcompinit
            bashcompinit
            complete -C "$_dotfiles_aws_completer" aws
            ;;
    esac
}

_dotfiles_find_executable() {
    _dotfiles_executable_name=$1
    _dotfiles_executable_remaining=${PATH-}:
    while [ -n "$_dotfiles_executable_remaining" ]; do
        _dotfiles_executable_directory=${_dotfiles_executable_remaining%%:*}
        _dotfiles_executable_remaining=${_dotfiles_executable_remaining#*:}
        [ -n "$_dotfiles_executable_directory" ] || _dotfiles_executable_directory=.
        _dotfiles_executable_path=$_dotfiles_executable_directory/$_dotfiles_executable_name
        if [ -f "$_dotfiles_executable_path" ] && [ -x "$_dotfiles_executable_path" ]; then
            printf '%s\n' "$_dotfiles_executable_path"
            return 0
        fi
    done
    return 0
}

_dotfiles_register_fzf() {
    _dotfiles_target=$1
    _dotfiles_fzf=$(_dotfiles_find_executable fzf) || return 0
    [ -n "$_dotfiles_fzf" ] || return 0

    case $_dotfiles_target in
        bash) _dotfiles_fzf_output=$(command "$_dotfiles_fzf" --bash 2>/dev/null) || return 0 ;;
        zsh) _dotfiles_fzf_output=$(command "$_dotfiles_fzf" --zsh 2>/dev/null) || return 0 ;;
        *) return 0 ;;
    esac
    [ -n "$_dotfiles_fzf_output" ] || return 0
    eval "$_dotfiles_fzf_output"
}

_dotfiles_register_zellij() {
    _dotfiles_target=$1
    _dotfiles_zellij=$(_dotfiles_find_executable zellij) || return 0
    [ -n "$_dotfiles_zellij" ] || return 0

    case $_dotfiles_target in
        bash) _dotfiles_zellij_output=$(command "$_dotfiles_zellij" setup --generate-completion bash 2>/dev/null) || return 0 ;;
        zsh)
            if ! command -v compdef >/dev/null 2>&1; then
                autoload -Uz compinit
                compinit -i
            fi
            _dotfiles_zellij_output=$(command "$_dotfiles_zellij" setup --generate-completion zsh 2>/dev/null) || return 0
            ;;
        *) return 0 ;;
    esac
    [ -n "$_dotfiles_zellij_output" ] || return 0
    eval "$_dotfiles_zellij_output"
}

dotfiles_generated_target() {
    _dotfiles_generated_tool=${1-}
    _dotfiles_generated_shell=${2-}
    case $_dotfiles_generated_shell in
        bash|zsh) ;;
        *) return 0 ;;
    esac
    case $_dotfiles_generated_tool in
        fnm)
            _dotfiles_generated_path=$(command -v fnm 2>/dev/null) || return 0
            [ -f "$_dotfiles_generated_path" ] && [ -x "$_dotfiles_generated_path" ] || return 0
            "$_dotfiles_generated_path" env --use-on-cd --version-file-strategy=recursive --shell "$_dotfiles_generated_shell"
            ;;
        zellij)
            _dotfiles_generated_path=$(command -v zellij 2>/dev/null) || return 0
            [ -f "$_dotfiles_generated_path" ] && [ -x "$_dotfiles_generated_path" ] || return 0
            "$_dotfiles_generated_path" setup --generate-auto-start "$_dotfiles_generated_shell"
            ;;
        *) return 0 ;;
    esac
}

dotfiles_integrations() {
    case ${1-} in
        bash|zsh) ;;
        *) return 0 ;;
    esac
    _dotfiles_register_aws "$1"
    _dotfiles_register_fzf "$1"
    _dotfiles_register_zellij "$1"
    return 0
}
